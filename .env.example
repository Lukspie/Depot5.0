# DepoTrack – konfigurácia prostredia.
# Skopíruj do .env (cp .env.example .env) a hodnoty "change-me" zmeň.
# Súbor .env sa NEcommituje.
# Heslá DB používaj bez znakov @ : / (zjednodušuje to pripojovacie reťazce).

# --- db-wms (obchodné dáta) ---
WMS_DB_NAME=depotrack_wms
WMS_DB_USER=depotrack
WMS_DB_PASSWORD=change-me-wms
# port na hostovi (publikovaný len na 127.0.0.1, napr. pre DBeaver)
WMS_DB_HOST_PORT=5433

# --- db-telemetry (telemetria) ---
TELEMETRY_DB_NAME=depotrack_telemetry
TELEMETRY_DB_USER=telematics
TELEMETRY_DB_PASSWORD=change-me-telemetry
TELEMETRY_DB_HOST_PORT=5434

# --- app (Python FastAPI, hlavný backend + frontend) ---
APP_PORT=8000
# originy, z ktorých smie prehliadač posielať POST/PUT/PATCH/DELETE (ochrana CSRF)
APP_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
# dĺžka session = dĺžka smeny
SESSION_TTL_HOURS=8
# true len pri HTTPS
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT=10/minute

# --- seed: heslá používateľov vytvorených pri prvom štarte (len vývoj/demo!) ---
# admin / dispecer / operator / ochranka / kurier01..kurier08
SEED_ADMIN_PASSWORD=admin-demo-2026
SEED_DISPATCHER_PASSWORD=dispecer-demo-2026
SEED_OPERATOR_PASSWORD=operator-demo-2026
SEED_SECURITY_PASSWORD=ochranka-demo-2026
SEED_COURIER_PASSWORD=kurier-demo-2026
SEED_PARCELS_PER_DAY=1500

# --- telematics (Node.js TypeScript) ---
TELEMATICS_PORT=8080
# URL, na ktorú sa pripája prehliadač (frontend volá telematiku priamo)
TELEMATICS_PUBLIC_URL=http://localhost:8080
# originy povolené pre CORS a WebSocket (čiarkou oddelené; 5173 = Vite dev server)
TELEMATICS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

# --- spoločné ---
LOG_LEVEL=info

# --- app <-> telematics ---
# zdieľané tajomstvo pre REST medzi backendmi (hlavička X-Service-Token)
SERVICE_TOKEN=change-me-service-token-0123456789
# tajomstvo na podpis WebSocket ticketov (JWT HS256, aspoň 32 znakov)
WS_TICKET_SECRET=change-me-ws-ticket-secret-0123456789abcdef
# kaskáda: príchod nočného kamióna + triediaci buffer > odchod prechodu => varovanie
CASCADE_BUFFER_MIN=30

# --- simulátor (telematics) ---
# simulované sekundy za reálnu sekundu (60 = 1 min za 1 s)
SIM_SPEED=60
# prvý simulovaný deň (YYYY-MM-DD), prázdne = dnes; čas štartu
SIM_START_DATE=
SIM_START_TIME=15:00
# rovnaký seed = rovnaký deň (meškania, zlé smery, degradácia); zmena tu sa prejaví po reštarte
SIM_RANDOM_SEED=42
# zaručené meškanie nočného kamióna, ktoré spôsobí kaskádové varovanie
SIM_FORCE_CASCADE=true
# skener, ktorý postupne stráca čítanosť (0,97 -> 0,85 za SIM_DEGRADATION_HOURS); "none" = žiadny
SIM_DEGRADED_DEVICE=DOCK-SCN-02
SIM_DEGRADATION_HOURS=6
# zariadenia ovládané reálnym hardvérom/skriptom (Fáza 6), čiarkou oddelené
SIM_EXTERNAL_DEVICES=
# čítanosť pod touto hranicou = zariadenie "degraded" (oranžový pin)
DEVICE_DEGRADED_THRESHOLD=0.92
# GDPR: prejazdy bránou (ŠPZ, snímky) sa mažú po tomto počte dní
GATE_RETENTION_DAYS=30
